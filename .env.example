# Copy to .env and adjust. No API keys or paid services are required.

RDD_ENVIRONMENT=development
RDD_LOG_LEVEL=INFO

# SQLite (default). For PostgreSQL later: postgresql+psycopg://user:password@localhost:5432/rdd_yolo
# Default (when unset): SQLite at outputs/rdd_yolo.db
# RDD_DATABASE_URL=sqlite:///E:/RDD-YOLO/outputs/rdd_yolo.db

# Checkpoint for inference (relative to project root). Empty = auto-select best in models/weights
RDD_MODEL_WEIGHTS=
# "" = auto (CUDA if available), "cpu", or a CUDA index like "0"
RDD_MODEL_DEVICE=
RDD_MODEL_IMGSZ=640
RDD_DEFAULT_CONFIDENCE=0.25

RDD_MAX_UPLOAD_MB=200
RDD_VIDEO_DEFAULT_STRIDE=3
RDD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite) - the dev server proxies /api and /files to this backend
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
